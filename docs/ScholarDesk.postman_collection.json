{
  "info": {
    "name": "ScholarDesk - Local API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order with ScholarDesk running. Creates temporary fictional test records and deletes only those records. Uses local PHP session cookies and CSRF token."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8053"
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "student_id",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Get session token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrf_token\", pm.response.json().data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=students",
        "body": {
          "mode": "raw",
          "raw": "{\"student_number\": \"PM-{{$timestamp}}\", \"full_name\": \"Postman Test Student\", \"email\": \"pm-{{$timestamp}}@example.test\", \"course\": \"BSCS\", \"year_level\": 2, \"section\": \"SE31\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"student_id\", pm.response.json().data.id);",
              "pm.test(\"Name saved\", () => pm.expect(pm.response.json().data.full_name).to.eql(\"Postman Test Student\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Retrieve student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=students&id={{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct student\", () => pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get(\"student_id\"))));",
              "pm.collectionVariables.set(\"student_number\", pm.response.json().data.student_number);",
              "pm.collectionVariables.set(\"student_email\", pm.response.json().data.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Update student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=students&id={{student_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"student_number\": \"{{student_number}}\", \"full_name\": \"Postman Updated Student\", \"email\": \"{{student_email}}\", \"course\": \"BSCS\", \"year_level\": 2, \"section\": \"SE31\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Name updated\", () => pm.expect(pm.response.json().data.full_name).to.eql(\"Postman Updated Student\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Reject invalid student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=students",
        "body": {
          "mode": "raw",
          "raw": "{\"student_number\": \"INVALID\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Postman test task\", \"subject\": \"CS0053\", \"due_date\": \"2099-12-31\", \"description\": \"Temporary record created during API testing.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"task_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Mark submitted",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=submissions",
        "body": {
          "mode": "raw",
          "raw": "{\"student_id\": \"{{student_id}}\", \"task_id\": \"{{task_id}}\", \"status\": \"submitted\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Submitted\", () => pm.expect(pm.response.json().data.status).to.eql(\"submitted\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Check dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Dashboard totals consistent\", () => { const d=pm.response.json().data; pm.expect(d.submitted+d.pending).to.eql(d.expected); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Mark pending",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=submissions",
        "body": {
          "mode": "raw",
          "raw": "{\"student_id\": \"{{student_id}}\", \"task_id\": \"{{task_id}}\", \"status\": \"pending\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Pending\", () => pm.expect(pm.response.json().data.status).to.eql(\"pending\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Delete test task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=tasks&id={{task_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Delete test student",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=students&id={{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Verify deleted student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api.php?route=students&id={{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}